# Copy to .env.local and fill in what you have. Everything is optional for
# local development: missing services fall back to safe local behaviour
# (see docs/DECISIONS.md D9). Never commit real values.

# --- Site ---------------------------------------------------------------
# Public origin for canonical links and share cards. On Vercel it defaults to the
# deployment URL; set it once you have a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shows the "Demo site" ribbon, disables call/message links and enables /demo.
# On unless set to false.
NEXT_PUBLIC_DEMO_MODE=true
# Let search engines index the site. Keep false for demos (the restaurant is fictional);
# set true for a real client launch.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Supabase (Project Settings → API Keys) -----------------------------
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_...). Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (sb_secret_...). Server only. Bypasses RLS.
SUPABASE_SECRET_KEY=

# --- PayHere (Phase 3). Unset = cash payments only -------------------------
# The merchant secret belongs to one domain (PayHere > Integrations), so set
# these for the production deployment only. See README, "Online payments".
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# true = sandbox.payhere.lk (test cards, no real money). false = live.
PAYHERE_SANDBOX=true

# --- Email: Resend (Phase 2). Unset = emails are printed to the console --
RESEND_API_KEY=
EMAIL_FROM="Kithul & Co. <onboarding@resend.dev>"

# --- Rate limiting: Upstash Redis. Unset = no rate limiting -------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Bot protection: Cloudflare Turnstile. Unset = Cloudflare test keys --
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Branch alerts (Phase 4) --------------------------------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional. Create a bot with @BotFather, then set each branch's chat ID in
# branch_secrets.telegram_chat_id (README, "Branch dashboard").
TELEGRAM_BOT_TOKEN=

# --- Scheduled jobs -----------------------------------------------------
# Any long random string. Scheduled GitHub Actions send it to our endpoints.
CRON_SECRET=
